# --- Banco de dados (Postgres) ---
# Use DATABASE_URL (Supabase/Neon/Render) OU as variáveis DB_* separadas.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=sua_senha
DB_NAME=escola_conecta
# true se o banco exige TLS (Supabase, Neon, Render). Local: false.
DB_SSL=false
# true cria/atualiza as tabelas automaticamente a partir das entidades.
# Prático no desenvolvimento; em produção use false e migrations.
DB_SYNC=true

# --- Autenticação ---
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=86400

# --- App ---
PORT=4001
# Pode ter vários domínios separados por vírgula.
FRONTEND_URL=http://localhost:3001
